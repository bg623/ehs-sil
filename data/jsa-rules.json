      "rule_id": "JSA-CONTROL-001",
      "rule_name": "控制措施过度依赖个体防护装备（Personal Protective Equipment，PPE）或培训",
      "applicable_scenario": ["all"],
      "trigger_condition": {"control_dependency_check":{"dependency_patterns":["ppe","防护用品","劳保","手套","安全带","护目镜","防护眼镜","防护面罩","呼吸防护","防毒面具","安全帽","防砸鞋","培训","教育","注意安全","认真操作","小心操作"],"higher_order_patterns":["消除","替代","隔离","上锁","挂牌","lototo","loto","盲板","护栏","平台","脚手架","联锁","通风","局部排风","检测","防爆工具","区域隔离","机械防护","防护罩","吊装禁入区"]}},
      "risk_category": "control_quality",
      "prompt_text": "当前控制措施可能主要依赖个体防护装备（Personal Protective Equipment，PPE）、培训或人员注意，请人工确认是否存在更高层级控制。",
      "reason": "仅依赖人员行为的控制更容易受现场条件、疲劳、沟通和执行偏差影响。",
      "recommended_action": "依次考虑消除、替代、工程控制和管理控制，再确认必要的个体防护装备（Personal Protective Equipment，PPE）。",
      "severity": "medium",
      "source": "GB/T 45001-2020第8.1.2条；美国国家职业安全卫生研究所（NIOSH）控制层级（Hierarchy of Controls）",
