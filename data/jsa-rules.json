    {
      "rule_id": "JSA-ENERGY-001",
      "rule_name": "危险能量隔离与验证",
      "applicable_scenario": ["maintenance", "equipment_opening", "electrical_work"],
      "trigger_condition": {"any_selected": ["electrical", "mechanical", "hydraulic", "pneumatic", "thermal", "gravity"]},
      "risk_category": "hazardous_energy",
      "prompt_text": "该场景涉及危险能量，请人工确认是否识别隔离点、释放或约束残余能量，并验证零能量状态。",
      "reason": "只写“停机”或“关闭阀门”通常不足以证明所有危险能量已被隔离和验证。",
      "recommended_action": "明确能量类型、隔离点、上锁挂牌责任、残余能量处理方式和验证方法。",
      "severity": "high",
      "source": "GB/T 44686-2024；GB/T 33579-2017；美国职业安全健康管理局（OSHA）29 CFR 1910.147",
      "source_refs": ["GB-T-44686-2024", "GB-T-33579-2017", "OSHA-1910-147"],
      "source_review_status": "product_owner_confirmed",
