{
  "version": "0.2.0",
  "policy": "deny_unlisted",
  "forbidden_payload_keys": [
    "before_json",
    "after_json",
    "title",
    "description",
    "facts",
    "conclusion",
    "action_text",
    "learning_summary",
    "person_name",
    "health_details",
    "attachment_name",
    "attachment_content",
    "email",
    "activation_code",
    "session_token"
  ],
  "allowed_value_fields": [
    "status",
    "actual_consequence",
    "potential_consequence",
    "investigation_level",
    "confidentiality",
    "reminder_status",
    "role",
    "membership_status"
  ],
  "events": [
    "auth.invite_created",
    "auth.invite_consumed",
    "auth.invite_denied",
    "auth.recovery_requested",
    "auth.recovery_consumed",
    "auth.session_revoked",
    "auth.access_denied",
    "membership.role_changed",
    "membership.status_changed",
    "incident.created",
    "incident.fields_changed",
    "incident.status_changed",
    "incident.close_requested",
    "incident.closed",
    "regulatory_report.status_changed",
    "investigation.status_changed",
    "corrective_action.assigned",
    "corrective_action.status_changed",
    "corrective_action.verified",
    "lfi.status_changed",
    "rollout.status_changed",
    "export.requested",
    "export.completed",
    "export.denied",
    "attachment.upload_completed",
    "attachment.download_denied",
    "platform.support_grant_created",
    "platform.support_accessed",
    "platform.support_grant_revoked"
  ],
  "record_shape": [
    "tenant_id",
    "actor_user_id",
    "action",
    "resource_type",
    "resource_id",
    "changed_fields_json",
    "allowed_values_json",
    "request_id",
    "result",
    "reason_code",
    "created_at"
  ]
}
