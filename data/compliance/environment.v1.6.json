          "sourceUrl": "https://www.mee.gov.cn/ywgz/fgbz/fl/202603/t20260313_1146496.shtml"
        },
        {
          "id": "ENV-CODE-GROUNDWATER",
          "reference": "第287条",
          "summary": "化工园区和化工项目、危险废物处置场等列举单位应采取防渗漏措施并建设地下水监测井；不能仅凭少量化学品使用就推断该义务。",
          "whenAny": [
            "危险化学品生产企业",
            "化学原料和化学制品制造",
            "危废处置",
            "危废填埋"
          ],
          "whenAll": [],
          "evidence": [
            "防渗设计和维护记录",
            "地下水监测井布设与报告"
