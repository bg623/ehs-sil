        },
        {
          "id": "ENV-CODE-POLLUTION",
          "reference": "第150—152条、第163—164条",
          "summary": "排放污染物应落实防治责任、适用排放标准与排污要求，规范排放口，不得以不正常运行治理设施等方式逃避监管。",
          "whenAny": [
            "产生废水",
            "排放工业废水",
            "排放生活污水",
            "产生废气",
            "排放VOCs",
            "排放颗粒物",
