  "controlApproaches": {
    "1":{"code":"CA1","title":"一般控制","action":"保持容器密闭、良好作业方法、一般通风、清洁和培训，并核实现有控制持续有效。"},
    "2":{"code":"CA2","title":"工程控制","action":"采用局部排风或等效源头控制，验证捕集效果并建立维护检查。"},
    "3":{"code":"CA3","title":"遏制 / 密闭","action":"优先采用更高等级密闭、隔离或自动化控制，限制人员进入并验证泄漏控制。"},
    "4":{"code":"CA4","title":"专家方案","action":"暂停依赖通用建议，由职业卫生与工艺安全专业人员制定并验证专项控制方案。"}
